{
  "name": "school-accounts",
  "version": "1.5.0",
  "description": "نظام حسابات المدرسة وإدارة الطلاب والرسوم والمدرسين والرواتب والمصروفات",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "server": "node server.js",
    "dist": "electron-builder --win nsis",
    "test:e2e": "playwright test",
    "test": "node --test tests/*.test.js",
    "test:fees": "node --test tests/fees.test.js",
    "test:db": "node --test tests/db.test.js",
    "test:seed": "node --test tests/seed-demo.test.js",
    "test:ui": "node --test tests/ui/*.test.js",
    "check": "node scripts/check-syntax.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "electron": "^37.10.3",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.yaghoub.schoolaccounts",
    "productName": "حسابات المدرسة",
    "files": [
      "main.js",
      "preload.js",
      "server.js",
      "db.js",
      "public/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "School-Accounts-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
